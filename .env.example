# Supabase - Conexão do Cliente (Browser)
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-ou-publishable"

# Supabase - Conexão do Servidor (SSR e Server Functions)
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sua-chave-anon-ou-publishable"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-admin"

# Banco de Dados (Opcional - para Drizzle Kit Migrations)
DATABASE_URL="postgresql://postgres:[SENHA]@[HOST]:5432/postgres"

# Cron (Opcional)
CRON_SECRET="seu-segredo-de-cron"
